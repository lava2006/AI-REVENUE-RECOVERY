# Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Razorpay Test Mode API Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
